# Copy this file to .env.local and fill in your actual values.
# .env.local is excluded from git automatically.

# Fallback URL (used if NEXT_PUBLIC_SUPERSET_SERVERS is empty)
NEXT_PUBLIC_SUPERSET_URL=http://your-superset-host:8088

# Comma-separated list of Superset servers available at the login screen.
# Format per entry: "Display Label|http://host:port"
# Example:
# NEXT_PUBLIC_SUPERSET_SERVERS=Production|http://prod-host:8088,Staging|http://staging-host:8088
NEXT_PUBLIC_SUPERSET_SERVERS=Server 1|http://your-superset-host-1:8088,Server 2|http://your-superset-host-2:8088
